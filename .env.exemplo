# Copie para ".env" e preencha só o que for usar. NUNCA compartilhe o .env.
# Chave para a reserva na nuvem (fallback) ou backend openai_compat:
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# Caminho alternativo do config:
# AGENTE_CONFIG=C:/IA/agente-local/config.yaml
# Busca reversa de imagens (opcional, desligada por padrão; veja docs/VISAO.md):
# SERPAPI_API_KEY=
